# Fragment applied on top of qcom_defconfig (scripts/kernel.sh, KERNEL_BASE).

# Size: the whole kernel image (initramfs included) compressed with XZ; preemption model and a few generic
# options of multi_v7_defconfig kept so the behaviour does not change with the smaller base.
CONFIG_KERNEL_XZ=y
CONFIG_INITRAMFS_COMPRESSION_NONE=y
CONFIG_PREEMPT_NONE=y
CONFIG_KERNEL_MODE_NEON=y
CONFIG_IPV6=y
CONFIG_AUTOFS_FS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_CPU_FREQ_STAT=y
# Options of qcom_defconfig with no use here: PM8058 keypad (no node on the TouchPad, its probe fails), dummy network interface
# CONFIG_KEYBOARD_PMIC8XXX is not set
# CONFIG_DUMMY is not set

# DTB appended to the zImage: the DTB is authoritative (memory + cmdline), not the ATAGs
# passed by the HP bootloader.
CONFIG_ARM_APPENDED_DTB=y
# CONFIG_ARM_ATAG_DTB_COMPAT is not set

# SoC
CONFIG_ARCH_QCOM=y
CONFIG_SMP=y

# Console / simple framebuffer (initialised by the bootloader)
CONFIG_FB_SIMPLE=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y

# First-boot debugging
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PRINTK_TIME=y

# USB gadget (shell/network without a UART)
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CHIPIDEA=y
CONFIG_USB_CHIPIDEA_UDC=y
CONFIG_USB_CHIPIDEA_MSM=y
CONFIG_CONFIGFS_FS=y

# initramfs
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Wi-Fi: Atheros AR6003 over SDIO (SDCC4), powered through an mmc-pwrseq
CONFIG_CFG80211=y
CONFIG_ATH6KL=y
CONFIG_ATH6KL_SDIO=y
CONFIG_PWRSEQ_SIMPLE=y

# Bluetooth: CSR BC6 on GSBI6 (UART), attached from userspace with btattach (later)
CONFIG_BT=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_H4=y
CONFIG_BT_HCIUART_BCSP=y
# Bring-up only: the Bluetooth power pins are driven from userspace through /sys/class/gpio
CONFIG_GPIO_SYSFS=y

# Debugging: dynamic debug (pr_debug/dev_dbg switchable at boot with dyndbg=) and a bigger log buffer
CONFIG_DYNAMIC_DEBUG=y
CONFIG_LOG_BUF_SHIFT=20

# Self-recovering hangs: hardware watchdog (the SoC timer block), reboot on panic, lockup/hung task
# detectors that panic (the trace goes to pstore/ramoops), PS_HOLD restart handler from the DTS.
CONFIG_QCOM_WDT=y
CONFIG_PANIC_TIMEOUT=5
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=60
CONFIG_BOOTPARAM_HUNG_TASK_PANIC=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y

# ath6kl debugging: messages selected at run time with /sys/module/ath6kl_core/parameters/debug_mask
CONFIG_ATH6KL_DEBUG=y

# SoC temperature sensor (TSENS) with its QFPROM calibration, thermal zones from the device tree
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_THERMAL_HWMON=y
CONFIG_QCOM_TSENS=y
CONFIG_NVMEM_QCOM_QFPROM=y
CONFIG_MFD_SYSCON=y

# Battery charger (MAX8903B, GPIO controlled) with USB source detection; VBUS extcon of the USB controller
CONFIG_POWER_SUPPLY=y
CONFIG_CHARGER_TENDERLOIN=y

# Battery gauge behind the A6 microcontroller (I2C, GSBI8)
CONFIG_BATTERY_HP_A6=y

# LCD backlight: PWM of the PM8058 LPG channel 0 plus the enable GPIO
CONFIG_PWM=y
CONFIG_PWM_PM8058_LPG=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y

# CPU frequency scaling (SCPLL clocks, cpufreq-dt, schedutil) and thermal throttling through the cpufreq cooling device
CONFIG_SCORPION_ACPU_CLK=y
CONFIG_REGULATOR_MSM8660_SAW=y
CONFIG_CPUFREQ_DT=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_THERMAL=y

# Display: MSM DRM (MDP4 + LCDC) with the patched parallel RGB encoder and a simple DPI panel (replaces simpledrm on the screen)
CONFIG_DRM_MSM=y
CONFIG_DRM_MSM_MDP4=y
# DRM_MSM can only be built in when its optional dependencies are not modules (no modules in the initramfs)
# CONFIG_QCOM_OCMEM is not set
# CONFIG_QCOM_COMMAND_DB is not set
# CONFIG_DRM_MSM_DPU is not set
# CONFIG_DRM_MSM_MDSS is not set
# CONFIG_DRM_MSM_DP is not set
# CONFIG_DRM_MSM_DSI is not set
# CONFIG_DRM_MSM_HDMI is not set
CONFIG_DRM_PANEL_SIMPLE=y

# GPU frequency scaling of the msm DRM driver (devfreq) and the clock controller of the MSM8660 multimedia block
CONFIG_DEVFREQ_GOV_SIMPLE_ONDEMAND=y
CONFIG_COMMON_CLK_QCOM=y
CONFIG_MSM_MMCC_8960=y

# Touch panel: userspace driver (ts_srv) creates the input device through uinput; 5 V touch supply switched from userspace
CONFIG_INPUT_UINPUT=y
CONFIG_REGULATOR_USERSPACE_CONSUMER=y

# Buttons: power key of the PM8058 (pwrkey node of pm8058.dtsi); volume up/down and home are TLMM GPIOs (gpio-keys in the DTS)
CONFIG_INPUT_PMIC8XXX_PWRKEY=y
CONFIG_KEYBOARD_GPIO=y

# Front camera (MT9M113): our driver (kernel/src/drivers/media/i2c/mt9m113.c, patch 0030)
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_SUPPORT_FILTER=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_VIDEO_DEV=y
CONFIG_VIDEO_CAMERA_SENSOR=y
CONFIG_VIDEO_MT9M113=y
# Camera capture: CSI1 + VFE 3.1 (kernel/src/drivers/media/platform/qcom/msm8660_vfe.c, patch 0022) -> /dev/video0, NV12 640x480
CONFIG_MEDIA_PLATFORM_DRIVERS=y
CONFIG_V4L_PLATFORM_DRIVERS=y
CONFIG_VIDEO_QCOM_MSM8660_VFE=y
# Hardware H.264: VIDC 1080p, qcom-vidc driver of the LuneOS port (kernel/src/drivers/media/platform/qcom/vidc, patch 0027).
# The s5p-mfc variant (old patch 0023) failed to boot the firmware and was dropped (the vidc driver is used instead).
CONFIG_V4L_MEM2MEM_DRIVERS=y
# CONFIG_VIDEO_SAMSUNG_S5P_MFC is not set
CONFIG_VIDEO_QCOM_VIDC=y

# Home button LEDs (LM8502): kernel/src/drivers/leds/leds-lm8502.c, patch 0031
CONFIG_LEDS_LM8502=y

# Sound without the Q6 DSP: LPASS audio interface (lpass-msm8660.c, patch 0025), LCC clocks (patch 0024), WM8958 codec on
# GSBI7 I2C 0x1a (mainline wm8994 MFD, LDO regulators, codec selected by the machine driver) and the machine driver tenderloin.c
CONFIG_SND_SOC_QCOM=y
CONFIG_SND_SOC_LPASS_MSM8660=y
CONFIG_MFD_WM8994=y
CONFIG_REGULATOR_WM8994=y
CONFIG_SND_SOC_TENDERLOIN=y
