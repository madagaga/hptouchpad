--- a/drivers/power/supply/Kconfig
+++ b/drivers/power/supply/Kconfig
@@ -1025,4 +1025,12 @@
 	  Say Y here to read the battery of the HP TouchPad (capacity, voltage,
 	  current, temperature) from its A6 microcontroller over I2C.
 
+config CHARGER_TENDERLOIN
+	tristate "HP TouchPad charger (MAX8903B) with USB charger type detection"
+	depends on GPIOLIB && EXTCON && OF
+	help
+	  Say Y here to drive the MAX8903B charger of the HP TouchPad: detection of the
+	  kind of USB source (PC port, charging port, adapter) on the D+/D- lines, input
+	  current limit, charge enable, and the VBUS extcon of the USB controller.
+
 endif # POWER_SUPPLY
