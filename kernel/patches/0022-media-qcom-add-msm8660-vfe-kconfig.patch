--- a/drivers/media/platform/qcom/Kconfig
+++ b/drivers/media/platform/qcom/Kconfig
@@ -4,3 +4,15 @@
 
 source "drivers/media/platform/qcom/camss/Kconfig"
 source "drivers/media/platform/qcom/venus/Kconfig"
+
+config VIDEO_QCOM_MSM8660_VFE
+	tristate "Qualcomm MSM8660 CSI1 + VFE 3.1 camera capture"
+	depends on V4L_PLATFORM_DRIVERS
+	depends on VIDEO_DEV && OF
+	select VIDEOBUF2_DMA_CONTIG
+	select V4L2_FWNODE
+	select V4L2_ASYNC
+	help
+	  Minimal capture driver for the front camera of the HP TouchPad (MSM8660):
+	  CSI-2 receiver CSI1 and VFE 3.1 in the state the vendor camera stack
+	  uses, NV12 640x480 on a V4L2 video node.
--- a/drivers/media/platform/qcom/Makefile
+++ b/drivers/media/platform/qcom/Makefile
@@ -1,3 +1,4 @@
 # SPDX-License-Identifier: GPL-2.0-only
 obj-y += camss/
 obj-y += venus/
+obj-$(CONFIG_VIDEO_QCOM_MSM8660_VFE) += msm8660_vfe.o
