+/*
+ * WLAN/BT coexistence (1 byte payload): the type of the Bluetooth chip sharing the antenna
+ * (1 Qualcomm, 2 CSR, 3 Atheros 3001, ...) and the front end antenna layout (1 single, 2 dual).
+ * The stock Atheros driver sends both right after the firmware is ready.
+ */
+int ath6kl_wmi_set_btcoex_colocated_bt_dev_cmd(struct wmi *wmi, u8 if_idx, u8 bt_dev)
+{
+	struct sk_buff *skb;
+
+	skb = ath6kl_wmi_get_new_buf(sizeof(u8));
+	if (!skb)
+		return -ENOMEM;
+
+	*(u8 *)skb->data = bt_dev;
+
+	return ath6kl_wmi_cmd_send(wmi, if_idx, skb, WMI_SET_BTCOEX_COLOCATED_BT_DEV_CMDID,
+				   NO_SYNC_WMIFLAG);
+}
+
+int ath6kl_wmi_set_btcoex_fe_ant_cmd(struct wmi *wmi, u8 if_idx, u8 fe_ant)
+{
+	struct sk_buff *skb;
+
+	skb = ath6kl_wmi_get_new_buf(sizeof(u8));
+	if (!skb)
+		return -ENOMEM;
+
+	*(u8 *)skb->data = fe_ant;
+
+	return ath6kl_wmi_cmd_send(wmi, if_idx, skb, WMI_SET_BTCOEX_FE_ANT_CMDID,
+				   NO_SYNC_WMIFLAG);
+}
