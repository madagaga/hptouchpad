+/*
+ * Qualcomm SDCC quirk: after a CMD53 write the card may stay busy and the controller does not
+ * wait for it. Send a dummy CMD52 (function 0, read register 0, result ignored) with PROGENA and
+ * wait for PROGDONE (not for CMDRESPEND: the response comes before the end of the card busy phase),
+ * like the downstream msm_sdcc driver does before the next request.
+ */
+static void mmci_qcom_dummy_cmd52(struct mmci_host *host)
+{
+	void __iomem *base = host->base;
+	u32 status;
+
+	writel(0, base + MMCIARGUMENT);
+	writel(SD_IO_RW_DIRECT | host->variant->cmdreg_cpsm_enable |
+	       host->variant->cmdreg_srsp | MCI_CPSM_QCOM_PROGENA,
+	       base + MMCICOMMAND);
+
+	if (readl_poll_timeout_atomic(base + MMCISTATUS, status,
+				      status & (MCI_QCOM_PROGDONE | MCI_CMDTIMEOUT |
+						MCI_CMDCRCFAIL),
+				      1, 100000))
+		dev_warn_once(mmc_dev(host->mmc), "dummy CMD52 did not complete\n");
+
+	writel(MCI_QCOM_PROGDONE | MCI_CMDTIMEOUT | MCI_CMDCRCFAIL | MCI_CMDRESPEND,
+	       base + MMCICLEAR);
+	writel(0, base + MMCICOMMAND);
+}
+
 static void mmci_request(struct mmc_host *mmc, struct mmc_request *mrq)
 {
 	struct mmci_host *host = mmc_priv(mmc);
