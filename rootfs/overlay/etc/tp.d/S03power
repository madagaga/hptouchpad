#!/bin/sh
# The tp daemon (rootfs/tp): power policy (charge source and current, charge window, low battery), Home button and screen sleep,
# and the commands of the settings panel that need state. Log: /tmp/tp.log (also in the kernel log).
case "$1" in
  start) /usr/local/bin/tp --daemon > /tmp/tp.log 2>&1 & ;;
  stop) pkill -f "tp --daemon" 2>/dev/null ;;
esac
