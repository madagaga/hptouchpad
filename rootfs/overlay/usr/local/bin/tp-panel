#!/bin/sh
# tp-panel: JSON API of the settings panel (docs/SETTINGS-PANEL.md), reached as `tp -j <command...>` through tp-sh, for the commands
# not ported to the C tp yet (battery, screen, panel, charge and power are native there). From the CGI mode of tp (which
# never uses a shell: every argument arrives as one argv entry) or by hand. Prints one JSON value: an object with "ok", or an array for
# lists. The arguments come from the page: validate each before it is used. Settings persist on the webOS media volume.
C=/mnt/media/touchpad
CONF=$C/tpd.conf
COG_OPTIONS=$C/cog-options
B=/sys/class/backlight/backlight
export DBUS_SESSION_BUS_ADDRESS=unix:path=/run/dbus-session

js() { printf '"%s"' "$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g' | tr -d '\001-\037')"; }
ok() { echo '{"ok":true}'; exit 0; }
fail() { printf '{"ok":false,"error":%s}\n' "$(js "$1")"; exit 0; }
todo() { fail "not implemented yet"; }
int_in() { case "$1" in ''|*[!0-9]*) return 1 ;; esac; [ "$1" -ge "$2" ] && [ "$1" -le "$3" ]; }
conf_get() { v=$(sed -n "s/^$1=//p" $CONF 2>/dev/null | tail -n1); echo "${v:-$2}"; }
conf_set() { touch $CONF; grep -v "^$1=" $CONF > $CONF.tmp; echo "$1=$2" >> $CONF.tmp; mv $CONF.tmp $CONF; sync; }
start_url() { U=about:blank; [ -s $C/url ] && U=$(head -n1 $C/url | tr -d '\r'); echo "$U"; }
cog_option() { [ ! -r "$COG_OPTIONS" ] || sed -n "s/^$1=//p" "$COG_OPTIONS" | tail -n1; }
restart_browser() {
  (sleep 1; /etc/tp.d/S90browser stop; sleep 1; setsid /etc/tp.d/S90browser start; sleep 6; tp panel open) > /dev/null 2>&1 &
}
valid_scale() {
  [ -z "$1" ] || printf '%s\n' "$1" | awk '/^[0-9]+([.][0-9]+)?$/ && $0 > 0 && $0 <= 10 { valid = 1 } END { exit !valid }'
}
# Screen rotation (0-3, quarter turns counter-clockwise, Cog's DRM "rotation" parameter): Cog rotates the picture but not the touch
# coordinates, so the touch screen gets the matching libinput calibration matrix through a udev rule (written here, read at device add).
rotation_rule() {
  case "$(conf_get rotation 0)" in
    1) M="0 -1 1 1 0 0" ;;
    2) M="-1 0 1 0 -1 1" ;;
    3) M="0 1 0 -1 0 1" ;;
    *) M="1 0 0 0 1 0" ;;
  esac
  echo "SUBSYSTEM==\"input\", ATTRS{name}==\"HPTouchpad\", ENV{LIBINPUT_CALIBRATION_MATRIX}=\"$M\"" > /etc/udev/rules.d/91-tp-rotation.rules
}
ntp_restart() {
  pkill -x ntpd 2>/dev/null
  [ "$(conf_get ntp 1)" = 1 ] && ntpd -p "$(conf_get ntp_server pool.ntp.org)"
}

case "$1" in
  info)
    printf '{"ok":true,"kernel":%s,' "$(js "Linux $(uname -r)")"
    printf '"battery":%s,' "$(js "$(cat /sys/class/power_supply/battery/capacity 2>/dev/null) % ($(cat /sys/class/power_supply/battery/status 2>/dev/null))")"
    printf '"cpu":%s,' "$(js "$(( $(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq 2>/dev/null || echo 0) / 1000 )) MHz")"
    printf '"temperature":%s,' "$(js "$(( $(cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null || echo 0) / 1000 )) °C")"
    printf '"ip":%s,' "$(js "$(ip -4 addr show wlan0 2>/dev/null | sed -n 's/.*inet \([0-9.]*\).*/\1/p')")"
    printf '"storage":%s,' "$(js "$(df -h / | awk 'NR==2 {print $3 " used of " $2}')")"
    printf '"uptime":%s}\n' "$(js "$(( $(cut -d. -f1 /proc/uptime) / 60 )) min")"
    ;;
  backlight)
    case "$2" in
      get) M=$(cat $B/max_brightness); printf '{"ok":true,"level":%d}\n' $(( ($(cat $B/brightness) * 100 + M / 2) / M )) ;;
      set) int_in "$3" 5 100 || fail "brightness is 5-100"; tp backlight "$3" > /dev/null; conf_set brightness "$3"; ok ;;
      *) fail "usage: backlight get|set <5-100>" ;;
    esac ;;
  rotation)
    case "$2" in
      get) printf '{"ok":true,"rotation":%d}\n' "$(conf_get rotation 0)" ;;
      rule) rotation_rule; ok ;;   # boot (S02udev): the rule only, before udev's first trigger
      set)
        int_in "$3" 0 3 || fail "rotation is 0-3"
        conf_set rotation "$3"; rotation_rule
        udevadm control --reload; udevadm trigger --action=change --subsystem-match=input
        # Cog reads the rotation at start: restart it in the background (this request is answered first), then show the panel again
        restart_browser
        ok ;;
      *) fail "usage: rotation get|set <0-3>" ;;
    esac ;;
  url)
    case "$2" in
      get) printf '{"ok":true,"url":%s}\n' "$(js "$(start_url)")" ;;
      set) case "$3" in http://?*|https://?*|file:///?*|about:blank) ;; *) fail "the URL must start with http://, https:// or file:///" ;; esac
           case "$3" in *" "*) fail "no spaces in the URL" ;; esac
           printf '%s\n' "$3" > $C/url; sync; ok ;;
      open) cogctl open "$(start_url)" || fail "cogctl failed"; rm -f /run/tp.panel; ok ;;
      *) fail "usage: url get|set <url>|open" ;;
    esac ;;
  browser)
    # WebKit cache of Cog (HOME=/ in S90browser): /.cache/wpe; /root/.cache/wpe comes from runs started by hand. Only the HTTP cache and
    # the Cache Storage are cleared: the site data (cookies, localStorage in /.local/share/wpe) and the HSTS list stay.
    CACHES="/.cache/wpe/WebKitCache /.cache/wpe/CacheStorage /root/.cache/wpe/WebKitCache /root/.cache/wpe/CacheStorage"
    case "$2" in
      reload) cogctl reload || fail "cogctl failed"; ok ;;
      options)
        printf '{"ok":true,"scale":%s,"deviceScale":%s,"bgColor":%s,"failure":%s,"permissions":%s,"docViewer":%s,"language":%s}\n' \
          "$(js "$(cog_option scale)")" "$(js "$(cog_option device-scale)")" "$(js "$(cog_option bg-color)")" \
          "$(js "$(cog_option webprocess-failure)")" "$(js "$(cog_option set-permissions)")" \
          "$(js "$(cog_option doc-viewer)")" "$(js "$(cog_option language)")" ;;
      set-options)
        [ "$#" -eq 9 ] || fail "expected seven browser settings"
        valid_scale "$3" && valid_scale "$4" || fail "scale must be greater than 0 and at most 10"
        [ -z "$5" ] || printf '%s\n' "$5" | grep -qE '^([a-zA-Z]+|#[0-9a-fA-F]{8})$' || fail "use a CSS color name or #RRGGBBAA"
        case "$6" in ''|error-page|exit|exit-ok|restart) ;; *) fail "invalid WebProcess failure action" ;; esac
        case "$7" in ''|none|all) ;; *) fail "invalid permissions setting" ;; esac
        case "$8" in ''|on) ;; *) fail "invalid document viewer setting" ;; esac
        [ -z "$9" ] || printf '%s\n' "$9" | grep -qE '^[a-zA-Z]{2,3}(-([a-zA-Z]{2}|[0-9]{3}))?$' || fail "use a language code such as fr or fr-FR"
        tmp=$(mktemp "$COG_OPTIONS.XXXXXX") || fail "cannot save browser settings"
        if ! { printf 'scale=%s\ndevice-scale=%s\nbg-color=%s\nwebprocess-failure=%s\nset-permissions=%s\ndoc-viewer=%s\nlanguage=%s\n' \
                 "$3" "$4" "$5" "$6" "$7" "$8" "$9" > "$tmp" && mv -f "$tmp" "$COG_OPTIONS"; }; then
          rm -f "$tmp"
          fail "cannot save browser settings"
        fi
        sync
        restart_browser
        ok ;;
      cache-size) printf '{"ok":true,"kb":%d}\n' "$(du -sk $CACHES 2>/dev/null | awk '{s += $1} END {print s + 0}')" ;;
      clear-cache)
        # the network process keeps the cache files open: stop Cog, clear, start it again, then show the panel again
        (sleep 1; /etc/tp.d/S90browser stop; sleep 1; rm -rf $CACHES; sync; setsid /etc/tp.d/S90browser start; sleep 6; tp panel open) \
          > /dev/null 2>&1 &
        ok ;;
      *) fail "usage: browser reload|cache-size|clear-cache|options|set-options" ;;
    esac ;;
  time)
    [ "$2" = set ] || fail "usage: time set 'YYYY-MM-DD HH:MM'"
    echo "$3" | grep -qE '^[0-9]{4}-[0-1][0-9]-[0-3][0-9] [0-2][0-9]:[0-5][0-9]$' || fail "expected YYYY-MM-DD HH:MM"
    date -s "$3:00" > /dev/null || fail "date refused the value"
    [ -c /dev/rtc0 ] && hwclock -w 2>/dev/null
    ok ;;
  tz)
    if [ "$2" = list ]; then
      cur=UTC; [ -s $C/tz ] && cur=$(head -n1 $C/tz)
      printf '{"ok":true,"tz":%s,"zones":[' "$(js "$cur")"
      { echo UTC; cd /usr/share/zoneinfo 2>/dev/null &&
        find Africa America Antarctica Arctic Asia Atlantic Australia Europe Indian Pacific -type f 2>/dev/null | sort; } |
        awk 'NR > 1 { printf "," } { printf "\"%s\"", $0 }'
      echo ']}'
    else
      case "$2" in ''|*..*|/*) fail "usage: tz list|<Area/City>" ;; esac
      [ -f "/usr/share/zoneinfo/$2" ] || fail "unknown time zone"
      ln -sf "/usr/share/zoneinfo/$2" /etc/localtime; printf '%s\n' "$2" > $C/tz; sync; ok
    fi ;;
  ntp)
    case "$2" in
      status)
        # "synced": ntpd runs and the clock is past 2025 (BusyBox ntpd has no status query)
        S=false; pidof ntpd > /dev/null && [ "$(date +%Y)" -ge 2025 ] && S=true
        printf '{"ok":true,"on":%s,"server":%s,"synced":%s}\n' "$([ "$(conf_get ntp 1)" = 1 ] && echo true || echo false)" \
          "$(js "$(conf_get ntp_server pool.ntp.org)")" $S ;;
      on|off) conf_set ntp "$([ "$2" = on ] && echo 1 || echo 0)"; ntp_restart; ok ;;
      server) echo "$3" | grep -qE '^[A-Za-z0-9][A-Za-z0-9.-]{0,252}$' || fail "invalid server name"; conf_set ntp_server "$3"; ntp_restart; ok ;;
      *) fail "usage: ntp status|on|off|server <host>" ;;
    esac ;;
  wifi)
    case "$2" in
      status)
        L=$(iw dev wlan0 link 2>/dev/null)
        P=false; ip link show wlan0 2>/dev/null | grep -q "<.*UP.*>" && P=true
        K=false; echo "$L" | grep -q '^Connected' && K=true
        F=$(echo "$L" | sed -n 's/^[[:space:]]*freq: \([0-9]*\).*/\1/p' | head -n1)
        S=$(echo "$L" | sed -n 's/^[[:space:]]*signal: \(-*[0-9]*\).*/\1/p')
        printf '{"ok":true,"power":%s,"connected":%s,"ssid":%s,"freq":%d,"signal":%d,"ip":%s}\n' $P $K \
          "$(js "$(echo "$L" | sed -n 's/^[[:space:]]*SSID: //p')")" "${F:-0}" "${S:-0}" \
          "$(js "$(ip -4 addr show wlan0 2>/dev/null | sed -n 's/.*inet \([0-9.]*\).*/\1/p')")" ;;
      list)
        wpa_cli -i wlan0 list_networks 2>/dev/null | awk -F '\t' 'NR > 1 && $1 ~ /^[0-9]+$/ {
          gsub(/\\/, "\\\\", $2); gsub(/"/, "\\\"", $2)
          printf "%s{\"id\":%d,\"ssid\":\"%s\",\"current\":%s}", n++ ? "," : "[", $1, $2, ($4 ~ /CURRENT/) ? "true" : "false" }
          END { print n ? "]" : "[]" }' ;;
      scan)
        ip link set wlan0 up 2>/dev/null
        iw dev wlan0 scan 2>/dev/null | awk '
          function flush() { if (ssid != "" && (!(ssid in best) || sig > best[ssid])) { best[ssid] = sig; sec[ssid] = s } }
          /^BSS / { flush(); ssid = ""; sig = -100; s = "open" }
          /signal:/ { sig = int($2) }
          /^[ \t]*SSID: / { sub(/^[ \t]*SSID: /, ""); ssid = $0 }
          /^[ \t]*RSN:/ { s = "WPA2" }
          /^[ \t]*WPA:/ { if (s == "open") s = "WPA" }
          /capability:.*Privacy/ { if (s == "open") s = "WEP" }
          END { flush()
                for (k in best) { e = k; gsub(/\\/, "\\\\", e); gsub(/"/, "\\\"", e)
                  printf "%s{\"ssid\":\"%s\",\"signal\":%d,\"sec\":\"%s\"}", n++ ? "," : "[", e, best[k], sec[k] }
                print n ? "]" : "[]" }' ;;
      add)
        # $3 SSID, $4 passphrase (empty: open network). The SSID goes in hex and the key as the PSK computed by wpa_passphrase, so no
        # quoting of user text reaches wpa_cli, and save_config never writes the passphrase itself.
        [ -n "$3" ] && [ ${#3} -le 32 ] || fail "the network name is 1-32 characters"
        [ -z "$4" ] || { [ ${#4} -ge 8 ] && [ ${#4} -le 63 ]; } || fail "the password is 8-63 characters"
        H=$(printf '%s' "$3" | od -An -tx1 | tr -d ' \n')
        if [ -n "$4" ]; then
          K=$(wpa_passphrase "$3" "$4" | sed -n 's/^[[:space:]]*psk=\([0-9a-f]\{64\}\)$/\1/p')
          [ -n "$K" ] || fail "cannot compute the key"
        fi
        N=$(wpa_cli -i wlan0 add_network | tail -n1)
        int_in "$N" 0 999 || fail "wpa_supplicant is not running"
        wpa_cli -i wlan0 set_network "$N" ssid "$H" | grep -q OK || { wpa_cli -i wlan0 remove_network "$N" > /dev/null; fail "invalid network name"; }
        wpa_cli -i wlan0 set_network "$N" scan_ssid 1 > /dev/null
        if [ -n "$4" ]; then wpa_cli -i wlan0 set_network "$N" psk "$K" > /dev/null
        else wpa_cli -i wlan0 set_network "$N" key_mgmt NONE > /dev/null; fi
        wpa_cli -i wlan0 select_network "$N" > /dev/null
        wpa_cli -i wlan0 enable_network all > /dev/null
        wpa_cli -i wlan0 save_config | grep -q OK || fail "network added but not saved"
        ok ;;
      remove|select)
        int_in "$3" 0 999 || fail "invalid network id"
        if [ "$2" = remove ]; then
          wpa_cli -i wlan0 remove_network "$3" | grep -q OK || fail "unknown network"
          wpa_cli -i wlan0 save_config > /dev/null
        else
          # select_network disables the others: enable them again so that they stay usable when this one is out of range
          wpa_cli -i wlan0 select_network "$3" | grep -q OK || fail "unknown network"
          wpa_cli -i wlan0 enable_network all > /dev/null
        fi
        ok ;;
      power)
        case "$3" in
          on)  ip link set wlan0 up; wpa_cli -i wlan0 reconnect > /dev/null; ok ;;
          off) wpa_cli -i wlan0 disconnect > /dev/null; pkill -f "udhcpc -i wlan0"; ip link set wlan0 down; ok ;;
          *) fail "usage: wifi power on|off" ;;
        esac ;;
      *) fail "usage: wifi status|list|scan|add <ssid> [passphrase]|remove <id>|select <id>|power on|off" ;;
    esac ;;
  bt)
    # bluetoothd (S20bluetooth) through bluetoothctl; the controller itself is powered by bt-power (GPIOs, hciattach, PSR)
    case "$2" in connect|pair|remove) echo "$3" | grep -qE '^([0-9A-F]{2}:){5}[0-9A-F]{2}$' || fail "invalid device address" ;; esac
    case "$2" in
      status)
        S=$(bluetoothctl show 2>/dev/null)
        P=false; echo "$S" | grep -q 'Powered: yes' && P=true
        V=false; echo "$S" | grep -q 'Discoverable: yes' && V=true
        printf '{"ok":true,"power":%s,"visible":%s,"paired":' $P $V
        if [ $P = true ]; then
          bluetoothctl devices Paired 2>/dev/null | while read -r d a n; do
            [ "$d" = Device ] || continue
            C=false; bluetoothctl info "$a" 2>/dev/null | grep -q 'Connected: yes' && C=true
            printf '%s\t%s\t%s\n' "$a" "$C" "$n"
          done
        fi | awk -F '\t' '{ gsub(/\\/, "\\\\", $3); gsub(/"/, "\\\"", $3)
               printf "%s{\"addr\":\"%s\",\"connected\":%s,\"name\":\"%s\"}", n++ ? "," : "[", $1, $2, $3 } END { print n ? "]}" : "[]}" }' ;;
      power)
        case "$3" in
          on)  conf_set bt 1; bt-power on > /dev/null 2>&1 || fail "the controller did not start (see /tmp/bt-power.log)"
               sleep 1; bluetoothctl power on > /dev/null 2>&1; ok ;;
          off) conf_set bt 0; bluetoothctl power off > /dev/null 2>&1; bt-power off > /dev/null 2>&1; ok ;;
          *) fail "usage: bt power on|off" ;;
        esac ;;
      visible)
        case "$3" in on|off) bluetoothctl discoverable "$3" > /dev/null 2>&1 && bluetoothctl pairable "$3" > /dev/null 2>&1 || fail "Bluetooth is off"; ok ;;
                     *) fail "usage: bt visible on|off" ;; esac ;;
      scan)
        bluetoothctl show 2>/dev/null | grep -q 'Powered: yes' || fail "Bluetooth is off"
        bluetoothctl --timeout 10 scan on > /dev/null 2>&1
        P=$(bluetoothctl devices Paired 2>/dev/null | awk '{print $2}')
        bluetoothctl devices 2>/dev/null | while read -r d a n; do
          [ "$d" = Device ] && ! echo "$P" | grep -qx "$a" && printf '%s\t%s\n' "$a" "$n"
        done | awk -F '\t' '{ gsub(/\\/, "\\\\", $2); gsub(/"/, "\\\"", $2)
               printf "%s{\"addr\":\"%s\",\"name\":\"%s\"}", n++ ? "," : "[", $1, $2 } END { print n ? "]" : "[]" }' ;;
      pair)
        # "Just Works" devices only for now: a device that asks for a passkey (most keyboards) would need it shown during the pairing
        R=$(bluetoothctl --timeout 30 pair "$3" 2>&1)
        echo "$R" | grep -q 'Pairing successful' || fail "pairing failed: $(echo "$R" | grep -iE 'fail|error|passkey' | tail -n1)"
        bluetoothctl trust "$3" > /dev/null 2>&1
        bluetoothctl connect "$3" > /dev/null 2>&1
        ok ;;
      connect) bluetoothctl connect "$3" 2>&1 | grep -q 'Connection successful' || fail "connection failed"; ok ;;
      remove) bluetoothctl remove "$3" 2>&1 | grep -q 'removed' || fail "unknown device"; ok ;;
      *) fail "usage: bt status|power on|off|visible on|off|scan|pair|connect|remove <address>" ;;
    esac ;;
  # The kernel writes the Palm "reboot" reason on a clean restart (patch 0008): the bootloader starts moboot, which shows its
  # menu and boots its default entry, Linux (docs/FLASHING.md). Not moboot.next: moboot 0.3.8 does not remove it, so it
  # would force that entry at every later boot (seen 2026-11-05).
  reboot) (sleep 1; sync; reboot) > /dev/null 2>&1 & ok ;;
  poweroff) (sleep 1; sync; poweroff) > /dev/null 2>&1 & ok ;;
  recovery) (sleep 1; sync; tp recovery) > /dev/null 2>&1 & ok ;;
  *) fail "unknown command" ;;
esac
